{
  "manifest_version": 3,
  "name": "TestLink Chat Panel",
  "version": "0.1.0",
  "description": "Opens the Dify agent's chat in Chrome's side panel, beside TestLink.",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open TestLink chat"
  }
}
